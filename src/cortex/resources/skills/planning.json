{
  "name": "planning",
  "description": "Planning and tracking: create plans, update roadmap, archive completed plans.",
  "tools": ["plan", "roadmap", "configure"],
  "when_to_use": "Creating or updating plans, registering plans in roadmap, completing roadmap steps, roadmap entry management.",
  "workflow_sequences": [
    "plan(operation=\"create\") → plan(operation=\"register\") → implement → plan(operation=\"complete\")",
    "update_memory_bank(operation=\"roadmap_remove\", entry_contains=...) → update_memory_bank(operation=\"progress_append\"|\"active_context_append\", ...)"
  ],
  "example_invocations": [
    "plan(operation=\"create\", title=\"...\", content=\"...\")",
    "plan(operation=\"complete\", plan_title=\"...\", summary=\"...\", plan_file_name=\"...\")",
    "update_memory_bank(operation=\"roadmap_remove\", entry_contains=\"unique substring\")"
  ],
  "troubleshooting_tips": [
    "Use update_memory_bank(operation=\"roadmap_remove\") with a unique substring to avoid removing the wrong bullet.",
    "When step references a plan file, prefer plan(operation=\"complete\") so the plan is archived automatically."
  ],
  "keywords": ["plan", "roadmap", "create_plan", "register_plan", "complete_plan", "roadmap_entry", "archive"],
  "workflow": {
    "mode": "sequential",
    "description": "Create plan, register in roadmap, and mark complete",
    "phases": [
      {
        "name": "create",
        "tool": "plan",
        "operation": "create",
        "required": true,
        "inputs": {},
        "outputs": ["plan_file_name", "plan_title", "status"]
      },
      {
        "name": "register",
        "tool": "plan",
        "operation": "register",
        "required": true,
        "inputs": {
          "create.plan_file_name": "plan_file_name",
          "create.plan_title": "plan_title"
        },
        "outputs": ["status"]
      },
      {
        "name": "complete",
        "tool": "plan",
        "operation": "complete",
        "required": false,
        "condition": "create.get('status') == 'success'",
        "inputs": {
          "create.plan_title": "plan_title"
        },
        "outputs": ["archived_path", "status"]
      }
    ]
  }
}

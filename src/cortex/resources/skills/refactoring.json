{
  "name": "refactoring",
  "description": "Code refactoring skill: analyse patterns, plan transformations, apply changes, and verify quality gates.",
  "tools": ["think", "plan", "manage_file", "run_quality_gate"],
  "workflow_sequences": [
    "Analyse code for refactoring candidates (oversized functions, god objects, DRY violations), then plan transformations, apply changes, and verify quality gates.",
    "Thread target_files and patterns from analyse phase into plan and apply phases automatically.",
    "Skip verify phase if apply failed to avoid misleading results."
  ],
  "workflow": {
    "mode": "sequential",
    "phases": [
      {
        "name": "analyse",
        "tool": "think",
        "operation": null,
        "inputs": {},
        "outputs": ["target_files", "patterns"],
        "condition": null,
        "retry_condition": null,
        "max_iterations": 1
      },
      {
        "name": "plan",
        "tool": "plan",
        "operation": "create",
        "inputs": {
          "analyse.target_files": "target_files",
          "analyse.patterns": "patterns"
        },
        "outputs": ["plan_file_name"],
        "condition": "analyse.get('status') == 'success'",
        "retry_condition": null,
        "max_iterations": 1
      },
      {
        "name": "apply",
        "tool": "manage_file",
        "operation": "write",
        "inputs": {
          "analyse.target_files": "target_files",
          "plan.plan_file_name": "plan_file_name"
        },
        "outputs": ["files_modified"],
        "condition": "plan.get('status') == 'success'",
        "retry_condition": null,
        "max_iterations": 1
      },
      {
        "name": "verify",
        "tool": "run_quality_gate",
        "operation": null,
        "inputs": {},
        "outputs": ["preflight_passed"],
        "condition": "apply.get('status') == 'success'",
        "retry_condition": null,
        "max_iterations": 1
      }
    ]
  },
  "when_to_use": "When restructuring existing code without changing behaviour: oversized functions, god objects, duplicated patterns, DRY violations, extracting helpers, or splitting a module that exceeds the file length limit.",
  "keywords": ["refactor", "refactoring", "extract", "duplication", "dry violation", "oversized", "god object", "restructure", "split module"]
}

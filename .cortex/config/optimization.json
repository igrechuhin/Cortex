{
  "enabled": true,
  "token_budget": {
    "default_budget": 80000,
    "max_budget": 100000,
    "reserve_for_response": 10000
  },
  "loading_strategy": {
    "default": "dependency_aware",
    "mandatory_files": [
      "memorybankinstructions.md"
    ],
    "priority_order": [
      "memorybankinstructions.md",
      "projectBrief.md",
      "activeContext.md",
      "systemPatterns.md",
      "techContext.md",
      "productContext.md",
      "progress.md"
    ]
  },
  "summarization": {
    "enabled": true,
    "auto_summarize_old_files": true,
    "age_threshold_days": 90,
    "target_reduction": 0.5,
    "strategy": "extract_key_sections",
    "cache_summaries": true
  },
  "relevance": {
    "keyword_weight": 0.4,
    "dependency_weight": 0.3,
    "recency_weight": 0.2,
    "quality_weight": 0.1
  },
  "performance": {
    "cache_enabled": true,
    "cache_ttl_seconds": 3600,
    "max_cache_size_mb": 50
  },
  "rules": {
    "enabled": true,
    "rules_folder": ".cortex/rules",
    "reindex_interval_minutes": 30,
    "auto_include_in_context": true,
    "max_rules_tokens": 5000,
    "min_relevance_score": 0.3,
    "rule_priority": "local_overrides_shared",
    "context_aware_loading": true,
    "always_include_generic": true,
    "context_detection": {
      "enabled": true,
      "detect_from_task": true,
      "detect_from_files": true,
      "language_keywords": {
        "python": [
          "python",
          "django",
          "flask",
          "fastapi",
          "pytest",
          "py"
        ],
        "swift": [
          "swift",
          "swiftui",
          "ios",
          "uikit",
          "combine",
          "cocoa"
        ],
        "javascript": [
          "javascript",
          "js",
          "react",
          "vue",
          "node",
          "typescript",
          "ts"
        ],
        "rust": [
          "rust",
          "cargo",
          "rustc"
        ],
        "go": [
          "golang",
          "go"
        ],
        "java": [
          "java",
          "spring",
          "maven",
          "gradle"
        ],
        "csharp": [
          "c#",
          "csharp",
          "dotnet",
          ".net"
        ],
        "cpp": [
          "c++",
          "cpp",
          "cmake"
        ]
      }
    }
  },
  "synapse": {
    "enabled": true,
    "synapse_folder": ".cortex/synapse",
    "synapse_repo": "https://github.com/igrechuhin/Synapse.git",
    "auto_sync": true,
    "sync_interval_minutes": 60
  },
  "self_evolution": {
    "enabled": true,
    "analysis": {
      "track_usage_patterns": true,
      "pattern_window_days": 5,
      "min_access_count": 5,
      "track_task_patterns": true
    },
    "insights": {
      "auto_generate": true,
      "min_impact_score": 0.5,
      "categories": [
        "usage",
        "organization",
        "redundancy",
        "dependencies",
        "quality"
      ]
    }
  },
  "tool_search": {
    "enabled": true,
    "always_loaded": [
      "add_roadmap_entry",
      "append_active_context_entry",
      "append_progress_entry",
      "check_mcp_connection_health",
      "complete_plan",
      "execute_pre_commit_checks",
      "fix_quality_issues",
      "get_memory_bank_stats",
      "get_structure_info",
      "load_context",
      "manage_file",
      "remove_roadmap_entry",
      "rules",
      "search_tools",
      "validate",
      "write_file"
    ],
    "deferred_medium": [
      "analyze",
      "analyze_context_effectiveness",
      "apply_refactoring",
      "check_structure_health",
      "configure",
      "create_plan",
      "fix_markdown_lint",
      "get_dependency_graph",
      "get_link_graph",
      "get_relevance_scores",
      "get_synapse_prompts",
      "get_synapse_rules",
      "get_version_history",
      "load_progressive_context",
      "parse_file_links",
      "read_cache_json",
      "register_plan_in_roadmap",
      "resolve_transclusions",
      "run_docs_and_memory_bank_sync",
      "run_preflight_checks",
      "sequentialthinking",
      "suggest_refactoring",
      "summarize_content",
      "sync_synapse",
      "update_config",
      "validate_links",
      "write_cache_json"
    ],
    "deferred_low": [
      "analyze_health_check",
      "analyze_session_scripts",
      "capture_session_script",
      "cleanup_metadata_index",
      "fix_roadmap_corruption",
      "get_context_usage_statistics",
      "get_optimization_recommendations",
      "get_tool_usage_report",
      "get_tool_usage_stats",
      "get_unused_tools",
      "get_usage_events",
      "get_usage_observation",
      "get_usage_timeline",
      "list_session_scripts",
      "promote_session_script",
      "provide_feedback",
      "rollback_file_version",
      "search_usage",
      "suggest_tool_improvements",
      "update_synapse_prompt",
      "update_synapse_rule"
    ]
  },
  "context_injection": {
    "enabled": true,
    "always_include_files": [
      "projectBrief.md",
      "activeContext.md",
      "systemPatterns.md"
    ],
    "recent_usage_events": 0,
    "max_usage_summary_tokens": 0
  }
}